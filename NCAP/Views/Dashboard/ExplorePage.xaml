<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCAP.Views.Dashboard.ExplorePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F7F5">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ═══════════════════════════════════════ -->
        <!-- HEADER                                  -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="0" BackgroundColor="#1A3C2E" Padding="20,52,20,20">
            <VerticalStackLayout Spacing="14">
                <Label Text="Explore Careers"
                       FontSize="22" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Browse 1,500+ occupations from the OFO database"
                       FontSize="12" TextColor="#AADDBB"/>

                <!-- Search bar -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0">
                        <Label Text="&#xE8B6;" FontFamily="MaterialOutlined"
                               FontSize="20" TextColor="#1A3C2E"
                               VerticalOptions="Center"/>
                        <Entry x:Name="SearchEntry"
                               Grid.Column="1"
                               Placeholder="Search careers..."
                               PlaceholderColor="#AAAAAA"
                               TextColor="#1A3C2E"
                               FontSize="13"
                               HeightRequest="46"
                               BackgroundColor="Transparent"
                               TextChanged="OnSearchChanged"/>
                        <Label x:Name="ClearSearch"
                               Grid.Column="2"
                               Text="&#xE5CD;" FontFamily="MaterialOutlined"
                               FontSize="20" TextColor="#AAAAAA"
                               VerticalOptions="Center"
                               IsVisible="False">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearSearch"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- FILTER CHIPS -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="White"
                    Padding="16,12">
            <HorizontalStackLayout Spacing="8" x:Name="FilterChips">

                <Border x:Name="ChipAll" BackgroundColor="#1A3C2E" StrokeThickness="0" Padding="14,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="All"/>
                    </Border.GestureRecognizers>
                    <Label Text="All" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                </Border>

                <Border x:Name="ChipDemand" BackgroundColor="#F5F7F5" StrokeThickness="1.5"
                        Stroke="#E0E0E0" Padding="14,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="HighDemand"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="🔥" FontSize="12"/>
                        <Label Text="High Demand" FontSize="12" TextColor="#1A3C2E"/>
                    </HorizontalStackLayout>
                </Border>

                <Border x:Name="ChipGreen" BackgroundColor="#F5F7F5" StrokeThickness="1.5"
                        Stroke="#E0E0E0" Padding="14,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Green"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="🌿" FontSize="12"/>
                        <Label Text="Green Careers" FontSize="12" TextColor="#1A3C2E"/>
                    </HorizontalStackLayout>
                </Border>

                <Border x:Name="ChipTrades" BackgroundColor="#F5F7F5" StrokeThickness="1.5"
                        Stroke="#E0E0E0" Padding="14,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Trades"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="🔧" FontSize="12"/>
                        <Label Text="Trades" FontSize="12" TextColor="#1A3C2E"/>
                    </HorizontalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════ -->
        <!-- CAREER LIST                             -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="2">

            <!-- List -->
            <CollectionView x:Name="CareerList"
                            Margin="0,8,0,0"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" StrokeThickness="0"
                                Margin="16,0" Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#22000000" Offset="0,2" Radius="8" Opacity="0.08"/>
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCareerTapped" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="56,*,Auto" Padding="14,14">

                                <!-- Icon -->
                                <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#xE8E5;" FontFamily="MaterialOutlined"
                                           FontSize="22" TextColor="#1A3C2E"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                     VerticalOptions="Center" Margin="12,0">
                                    <Label Text="{Binding title}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="#1A3C2E" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding major_group}"
                                           FontSize="11" TextColor="#888888"/>
                                    <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                        <!-- High demand badge -->
                                        <Border BackgroundColor="#FFF3E0" StrokeThickness="0"
                                                Padding="6,3"
                                                IsVisible="{Binding is_high_demand}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="🔥 High Demand" FontSize="10"
                                                   TextColor="#E65100" FontAttributes="Bold"/>
                                        </Border>
                                        <!-- Green badge -->
                                        <Border BackgroundColor="#E8F5E9" StrokeThickness="0"
                                                Padding="6,3"
                                                IsVisible="{Binding is_green_career}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="🌿 Green" FontSize="10"
                                                   TextColor="#2E7D32" FontAttributes="Bold"/>
                                        </Border>
                                        <!-- Trade badge -->
                                        <Border BackgroundColor="#E3F2FD" StrokeThickness="0"
                                                Padding="6,3"
                                                IsVisible="{Binding is_trade}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="🔧 Trade" FontSize="10"
                                                   TextColor="#1565C0" FontAttributes="Bold"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Arrow -->
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;" FontFamily="MaterialOutlined"
                                       FontSize="20" TextColor="#CCCCCC"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty state -->
            <VerticalStackLayout x:Name="EmptyState"
                                 IsVisible="False"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <Label Text="&#xE8B6;" FontFamily="MaterialOutlined"
                       FontSize="48" TextColor="#CCCCCC"
                       HorizontalOptions="Center"/>
                <Label Text="No careers found"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="#AAAAAA" HorizontalOptions="Center"/>
                <Label Text="Try a different search or filter"
                       FontSize="13" TextColor="#CCCCCC"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!-- CAREER DETAIL DRAWER (slides from right)-->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="DrawerOverlay"
              IsVisible="False">

            <!-- Dim background -->
            <BoxView Color="#80000000" HorizontalOptions="Fill" VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseDrawer"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Drawer panel -->
            <Grid x:Name="DrawerPanel"
                  BackgroundColor="White"
                  HorizontalOptions="End"
                  VerticalOptions="Fill"
                  WidthRequest="320"
                  TranslationX="320"
                  RowDefinitions="Auto,*">

                <!-- Drawer header -->
                <Grid Grid.Row="0" BackgroundColor="#1A3C2E" Padding="20,52,20,20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Career Detail"
                                   FontSize="11" TextColor="#AADDBB"
                                   CharacterSpacing="1.2" FontAttributes="Bold"/>
                            <Label x:Name="DrawerTitle"
                                   Text=""
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="White" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#2D5A40"
                                WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseDrawer"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xE5CD;" FontFamily="MaterialOutlined"
                                   FontSize="18" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Drawer content -->
                <ScrollView Grid.Row="1" BackgroundColor="White" Padding="20,20,20,40">
                    <VerticalStackLayout Spacing="20">

                        <!-- OFO Code + Group badges -->
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="#E8F5EE" StrokeThickness="0" Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label x:Name="DrawerOfoCode"
                                       Text="" FontSize="11" FontAttributes="Bold"
                                       TextColor="#1A3C2E"/>
                            </Border>
                            <Border BackgroundColor="#F5F7F5" StrokeThickness="0" Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label x:Name="DrawerGroup"
                                       Text="" FontSize="11"
                                       TextColor="#666666"/>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="About this Career"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#1A3C2E"/>
                            <Label x:Name="DrawerDescription"
                                   Text=""
                                   FontSize="13" TextColor="#555555"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Tasks -->
                        <VerticalStackLayout x:Name="DrawerTasksSection" Spacing="8">
                            <Label Text="Key Tasks"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#1A3C2E"/>
                            <VerticalStackLayout x:Name="DrawerTasks" Spacing="6"/>
                        </VerticalStackLayout>

                        <!-- Learning Pathways -->
                        <VerticalStackLayout x:Name="DrawerPathwaysSection" Spacing="8">
                            <Label Text="Learning Pathways"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#1A3C2E"/>
                            <VerticalStackLayout x:Name="DrawerPathways" Spacing="6"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </Grid>


    </Grid>
</ContentPage>

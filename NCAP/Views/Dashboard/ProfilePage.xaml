<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCAP.Views.Dashboard.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F7F5">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ═══════════════════════════════════════ -->
            <!-- HEADER                                  -->
            <!-- ═══════════════════════════════════════ -->
            <Grid BackgroundColor="#1A3C2E" Padding="24,52,24,32">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                    <!-- Avatar -->
                    <Border BackgroundColor="#2D5A40"
                            WidthRequest="80" HeightRequest="80"
                            StrokeThickness="3" Stroke="#4CAF93"
                            HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="40"/></Border.StrokeShape>
                        <Label Text="&#xE7FD;" FontFamily="MaterialOutlined"
                               FontSize="42" TextColor="#4CAF93"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Name + Category -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label x:Name="UserNameLabel"
                               Text="My Profile"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Border BackgroundColor="#2D5A40"
                                StrokeThickness="0"
                                Padding="12,4"
                                HorizontalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <Label x:Name="CategoryLabel"
                                   Text="Learner"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="#4CAF93"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <!-- ═══════════════════════════════════════ -->
            <!-- MY DETAILS                              -->
            <!-- ═══════════════════════════════════════ -->
            <Label Text="MY DETAILS"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#999999" CharacterSpacing="1.5"
                   Margin="20,24,20,10"/>

            <Border BackgroundColor="White" StrokeThickness="0"
                    Margin="16,0" Padding="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.08"/></Border.Shadow>
                <VerticalStackLayout Spacing="0">

                    <!-- Province -->
                    <Grid ColumnDefinitions="48,*,Auto" Padding="16,16">
                        <Border BackgroundColor="#E8F5EE" WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="&#xE55C;" FontFamily="MaterialOutlined"
                                   FontSize="20" TextColor="#1A3C2E"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Province" FontSize="11" TextColor="#999999"/>
                            <Label x:Name="ProvinceLabel" Text="—"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F5F5F5" Margin="16,0"/>

                    <!-- Language -->
                    <Grid ColumnDefinitions="48,*,Auto" Padding="16,16">
                        <Border BackgroundColor="#E8F5EE" WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="&#xE8C4;" FontFamily="MaterialOutlined"
                                   FontSize="20" TextColor="#1A3C2E"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Home Language" FontSize="11" TextColor="#999999"/>
                            <Label x:Name="LanguageLabel" Text="—"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- MY CAREER INTERESTS                     -->
            <!-- ═══════════════════════════════════════ -->
            <Label Text="MY CAREER INTERESTS"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#999999" CharacterSpacing="1.5"
                   Margin="20,24,20,10"/>

            <Border BackgroundColor="White" StrokeThickness="0"
                    Margin="16,0" Padding="20">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.08"/></Border.Shadow>
                <VerticalStackLayout x:Name="InterestsContainer" Spacing="14">
                    <Label Text="Complete the interest quiz in the Guide tab to see your top career fields here."
                           FontSize="13" TextColor="#AAAAAA"
                           HorizontalTextAlignment="Center"
                           x:Name="InterestsPlaceholder"/>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- CONTACT KHETHA                          -->
            <!-- ═══════════════════════════════════════ -->
            <Label Text="CONTACT KHETHA"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#999999" CharacterSpacing="1.5"
                   Margin="20,24,20,10"/>

            <Border BackgroundColor="White" StrokeThickness="0"
                    Margin="16,0" Padding="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.08"/></Border.Shadow>
                <VerticalStackLayout Spacing="0">

                    <!-- Phone -->
                    <Grid ColumnDefinitions="48,*" Padding="16,16">
                        <Border BackgroundColor="#E8F5EE" WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="&#xE0CD;" FontFamily="MaterialOutlined"
                                   FontSize="20" TextColor="#1A3C2E"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Helpline" FontSize="11" TextColor="#999999"/>
                            <Label Text="086 999 0123"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A3C2E">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCallTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F5F5F5" Margin="16,0"/>

                    <!-- WhatsApp -->
                    <Grid ColumnDefinitions="48,*" Padding="16,16">
                        <Border BackgroundColor="#E8F5EE" WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="&#xE0C9;" FontFamily="MaterialOutlined"
                                   FontSize="20" TextColor="#1A3C2E"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="WhatsApp" FontSize="11" TextColor="#999999"/>
                            <Label Text="072 204 5056"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A3C2E">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWhatsAppTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F5F5F5" Margin="16,0"/>

                    <!-- Email -->
                    <Grid ColumnDefinitions="48,*" Padding="16,16">
                        <Border BackgroundColor="#E8F5EE" WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="&#xE0BE;" FontFamily="MaterialOutlined"
                                   FontSize="20" TextColor="#1A3C2E"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Email" FontSize="11" TextColor="#999999"/>
                            <Label Text="careerhelp@dhet.gov.za"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A3C2E">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEmailTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- SIGN OUT                                -->
            <!-- ═══════════════════════════════════════ -->
            <Border BackgroundColor="White" StrokeThickness="1.5"
                    Stroke="#FFEBEE" Margin="16,24,16,40"
                    Padding="0" HeightRequest="54">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="&#xE9BA;" FontFamily="MaterialOutlined"
                           FontSize="20" TextColor="#D32F2F"
                           VerticalOptions="Center"/>
                    <Label Text="Sign Out"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#D32F2F"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

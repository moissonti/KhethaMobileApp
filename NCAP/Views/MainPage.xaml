<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCAP.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F7F5">

    <Grid RowDefinitions="260,*,Auto">

        <!-- ═══════════════════════════════════════ -->
        <!-- CAROUSEL (flush to top, no logos)       -->
        <!-- ═══════════════════════════════════════ -->
        <Grid x:Name="CarouselContainer" Grid.Row="0" HeightRequest="260" ZIndex="10">

            <Image x:Name="SlideImage" Aspect="AspectFill" HeightRequest="260"
                   VerticalOptions="Fill" HorizontalOptions="Fill"/>

            <!-- Bottom gradient only -->
            <BoxView VerticalOptions="Fill" HorizontalOptions="Fill">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#CC000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Slide badge text -->
            <Label x:Name="SlideBadgeLabel"
                   VerticalOptions="End" HorizontalOptions="Start"
                   Margin="20,0,20,44"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="White" CharacterSpacing="1.2"/>

            <!-- Slide subtitle -->
            <Label x:Name="SlideSubtitleLabel"
                   VerticalOptions="End" HorizontalOptions="Start"
                   Margin="20,0,20,24"
                   FontSize="13" TextColor="#CCFFFFFF"/>

            <!-- Dots -->
            <HorizontalStackLayout x:Name="DotsContainer"
                                   HorizontalOptions="Center" VerticalOptions="End"
                                   Margin="0,0,0,8" Spacing="6"/>
        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!-- SCROLLABLE CONTENT                      -->
        <!-- ═══════════════════════════════════════ -->
        <ScrollView Grid.Row="1" BackgroundColor="#F5F7F5">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- LOGOS + TAGLINE STRIP (below carousel) -->
                <VerticalStackLayout BackgroundColor="White"
                                     Padding="20,18,20,18" Spacing="12">

                    <!-- Logos -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="16" VerticalOptions="Center">
                        <Image Source="dhet_logo.png"
                               HeightRequest="34" Aspect="AspectFit"/>
                        <BoxView WidthRequest="1" HeightRequest="30"
                                 Color="#E0E0E0" VerticalOptions="Center"/>
                        <Image Source="khetha_logo.png"
                               HeightRequest="34" Aspect="AspectFit"/>
                    </HorizontalStackLayout>

                    <!-- Tagline -->
                    <Label x:Name="TaglineLabel"
                           Text="Your Career Guidance Companion, On the Go"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A3C2E"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label x:Name="TaglineSubLabel"
                           Text="Free · Trusted · For Every South African"
                           FontSize="11" TextColor="#4CAF93"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- Section label -->
                <Label x:Name="SectionLabel"
                       Text="WHAT YOU CAN DO"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="#999999" CharacterSpacing="1.5"
                       Margin="16,16,16,10"/>

                <!-- 2-COLUMN FEATURE GRID -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="10" Margin="16,0,16,0">

                    <!-- Card 1 -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.10"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="14,16" Spacing="10">
                            <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="&#xE8F8;" FontFamily="MaterialOutlined" FontSize="24"
                                       TextColor="#1A3C2E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="Card1Title" Text="Career Choice Quiz"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1A3C2E" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card1Sub" Text="Personalised career suggestions"
                                   FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card1Action" Text="Start →"
                                   FontSize="12" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 2 -->
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.10"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="14,16" Spacing="10">
                            <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="&#xE865;" FontFamily="MaterialOutlined" FontSize="24"
                                       TextColor="#1A3C2E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="Card2Title" Text="Subject Chooser"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1A3C2E" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card2Sub" Text="Right subjects for your stream"
                                   FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card2Action" Text="Start →"
                                   FontSize="12" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 3 -->
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.10"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="14,16" Spacing="10">
                            <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="&#xEA4A;" FontFamily="MaterialOutlined" FontSize="24"
                                       TextColor="#1A3C2E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="Card3Title" Text="Job Fit Assessment"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1A3C2E" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card3Sub" Text="Find roles that suit your personality"
                                   FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card3Action" Text="Start →"
                                   FontSize="12" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 4 -->
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.10"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="14,16" Spacing="10">
                            <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="&#xE80C;" FontFamily="MaterialOutlined" FontSize="24"
                                       TextColor="#1A3C2E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="Card4Title" Text="Study Directories"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1A3C2E" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card4Sub" Text="Universities, TVETs &amp; qualifications"
                                   FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card4Action" Text="Explore →"
                                   FontSize="12" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 5 -->
                    <Border Grid.Row="2" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.10"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="14,16" Spacing="10">
                            <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="&#xE8E5;" FontFamily="MaterialOutlined" FontSize="24"
                                       TextColor="#1A3C2E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="Card5Title" Text="Green &amp; High-Demand"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1A3C2E" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card5Sub" Text="Future-ready occupation insights"
                                   FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card5Action" Text="View →"
                                   FontSize="12" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 6 -->
                    <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,2" Radius="10" Opacity="0.10"/>
                        </Border.Shadow>
                        <VerticalStackLayout Padding="14,16" Spacing="10">
                            <Border BackgroundColor="#E8F5EE" WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="&#xE648;" FontFamily="MaterialOutlined" FontSize="24"
                                       TextColor="#1A3C2E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="Card6Title" Text="Works Offline"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1A3C2E" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card6Sub" Text="Low-bandwidth &amp; rural friendly"
                                   FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                            <Label x:Name="Card6Action" Text="Learn more →"
                                   FontSize="12" FontAttributes="Bold" TextColor="#1A3C2E"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Footer -->
                <Label x:Name="FooterLabel"
                       Text="A free service by the Department of Higher Education &amp; Training"
                       FontSize="11" TextColor="#AAAAAA"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       Margin="24,20,24,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════ -->
        <!-- BOTTOM BUTTONS                          -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" BackgroundColor="White"
              Padding="16,12,16,28" ColumnSpacing="12">
            <Grid.Shadow>
                <Shadow Brush="#22000000" Offset="0,-3" Radius="12" Opacity="0.10"/>
            </Grid.Shadow>

            <Border Grid.Column="0" BackgroundColor="#C8972B" StrokeThickness="0" HeightRequest="50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                </Border.GestureRecognizers>
                <Label x:Name="RegisterBtn" Text="Register" FontSize="15" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Border Grid.Column="1" BackgroundColor="#1A3C2E" StrokeThickness="0" HeightRequest="50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoginTapped"/>
                </Border.GestureRecognizers>
                <Label x:Name="LoginBtn" Text="Log In" FontSize="15" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

        </Grid>

    </Grid>
</ContentPage>
